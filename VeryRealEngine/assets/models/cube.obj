# Unit cube, one quad per face, each with its own UVs and normal
# (i.e. 24 unique position/normal/uv vertex combos, not 8 shared corners).
mtllib cube.mtl
usemtl checker

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn  0  0 -1
vn  0  0  1
vn -1  0  0
vn  1  0  0
vn  0 -1  0
vn  0  1  0

# -Z face
f 1/1/1 2/2/1 3/3/1 4/4/1
# +Z face
f 6/1/2 5/2/2 8/3/2 7/4/2
# -X face
f 5/1/3 1/2/3 4/3/3 8/4/3
# +X face
f 2/1/4 6/2/4 7/3/4 3/4/4
# -Y face
f 5/1/5 6/2/5 2/3/5 1/4/5
# +Y face
f 4/1/6 3/2/6 7/3/6 8/4/6
